{
  "geppetto": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./skills/geppetto-adopt/scripts/hook.mjs --harness antigravity",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./skills/geppetto-adopt/scripts/hook.mjs --harness antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./skills/geppetto-adopt/scripts/hook.mjs --harness antigravity",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./skills/geppetto-adopt/scripts/hook.mjs --harness antigravity",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./skills/geppetto-adopt/scripts/hook.mjs --harness antigravity",
        "timeout": 30
      }
    ]
  }
}
