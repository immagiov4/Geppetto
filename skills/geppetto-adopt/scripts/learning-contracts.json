{
  "tools": {
    "Read": {
      "path": {
        "type": "string"
      }
    },
    "Write": {
      "path": {
        "type": "string"
      },
      "content": {
        "type": "string"
      }
    },
    "Edit": {
      "path": {
        "type": "string"
      },
      "oldText": {
        "type": "string"
      },
      "newText": {
        "type": "string"
      }
    },
    "Glob": {
      "glob": {
        "type": "string"
      }
    },
    "Grep": {
      "text": {
        "type": "string"
      },
      "glob": {
        "type": "string"
      }
    },
    "ProposeExperiments": {
      "proposals": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "properties": {
            "evidence": { "type": "string" },
            "procedure": { "type": "string" },
            "decisionRule": { "type": "string" }
          },
          "required": ["evidence", "procedure", "decisionRule"],
          "additionalProperties": false
        }
      }
    },
    "MaintainEvidence": {
      "action": {
        "type": "string",
        "enum": [
          "merge",
          "category"
        ]
      },
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reason": {
        "type": "string"
      },
      "category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "score": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "definition",
          "score"
        ],
        "additionalProperties": false
      }
    }
  }
}
