{
  "checks": [
    {
      "id": "requirements",
      "question": "Does this software product request substantially change behavior or agreed requirements? Also check whether this work introduces or changes a foundation under geppetto-spec. Exclude tiny localized edits, standalone documentary research, prose work and tasks unrelated to product development.",
      "skill": "requirements-blast-radius"
    },
    {
      "id": "feedback",
      "question": "Is this feedback from the user, a reviewer, CI or a delegated agent?",
      "skill": "receive-work-feedback"
    },
    {
      "id": "frustration",
      "question": "Does this message express frustration caused by the work?",
      "skill": "geppetto-learn"
    }
  ],
  "rearmOn": [
    {
      "tool": "^(Bash|exec_command|shell_command|shell|run_command)$",
      "gh": "api",
      "path": "^/?repos/[^/]+/[^/]+/pulls/\\d+/(comments|reviews)(?:\\?.*)?$"
    },
    {
      "tool": "^(Bash|exec_command|shell_command|shell|run_command)$",
      "gh": "pr view",
      "flags": ["--comments"]
    },
    {
      "tool": "^(Bash|exec_command|shell_command|shell|run_command)$",
      "script": "(?:^|[/\\\\])code-review[/\\\\]scripts[/\\\\]run_review\\.py$"
    },
    {
      "tool": "^(wait_agent|Task|Agent|task_result|invoke_subagent)$"
    },
    {
      "tool": "^(Bash|exec_command|shell_command|shell|run_command)$",
      "gh": "run view",
      "flags": ["--log-failed"]
    },
    {
      "tool": "^(Bash|exec_command|shell_command|shell|run_command)$",
      "gh": "pr checks"
    }
  ]
}
